{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/davidahmann/fde-guide/schemas/system-map-manifest.schema.json",
  "title": "Versioned system-map manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "map_id", "version", "status", "map_kind", "scope", "sources", "derivation", "nodes", "relations", "usage", "freshness", "control_ids"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "map_id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/version" },
    "status": { "enum": ["candidate", "verified", "stale", "retired"] },
    "map_kind": { "enum": ["software", "operational", "combined"] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system_id", "description", "in_scope", "out_of_scope"],
      "properties": {
        "system_id": { "$ref": "#/$defs/id" },
        "description": { "type": "string", "minLength": 20 },
        "in_scope": { "$ref": "#/$defs/nonEmptyStrings" },
        "out_of_scope": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 4 } }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/source" }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "producer", "input_revision", "executed_at", "coverage", "semantic_processing"],
      "properties": {
        "method": { "enum": ["deterministic", "semantic", "hybrid", "manual"] },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "configuration_digest"],
          "properties": {
            "name": { "type": "string", "minLength": 2 },
            "version": { "type": "string", "minLength": 1 },
            "configuration_digest": { "$ref": "#/$defs/digest" }
          }
        },
        "input_revision": { "type": "string", "minLength": 1 },
        "executed_at": { "type": "string", "format": "date-time" },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "included_source_ids", "excluded_reason"],
          "properties": {
            "status": { "enum": ["complete", "partial", "not_measured"] },
            "included_source_ids": { "$ref": "#/$defs/idArray" },
            "excluded_reason": { "oneOf": [{ "type": "string", "minLength": 10 }, { "type": "null" }] }
          }
        },
        "semantic_processing": { "enum": ["none", "local_model", "approved_remote_model"] }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/node" }
    },
    "relations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relation" }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_purposes", "prohibited_purposes", "access_classification", "retention", "query_logging"],
      "properties": {
        "allowed_purposes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["navigation", "design_review", "change_impact", "bounded_read_only_retrieval", "onboarding"] }
        },
        "prohibited_purposes": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["authorization", "effect_authorization", "completion_proof", "policy_definition", "unbounded_memory"] },
          "allOf": [
            { "contains": { "const": "authorization" }, "minContains": 1 },
            { "contains": { "const": "effect_authorization" }, "minContains": 1 },
            { "contains": { "const": "completion_proof" }, "minContains": 1 }
          ]
        },
        "access_classification": { "enum": ["public", "internal", "confidential", "restricted"] },
        "retention": { "type": "string", "minLength": 10 },
        "query_logging": { "enum": ["disabled", "metadata_only", "approved_audit_log"] }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_verified_at", "objective", "invalidation_triggers", "owner", "stale_behavior"],
      "properties": {
        "last_verified_at": { "type": "string", "format": "date-time" },
        "objective": { "type": "string", "minLength": 10 },
        "invalidation_triggers": { "$ref": "#/$defs/nonEmptyStrings" },
        "owner": { "type": "string", "minLength": 2 },
        "stale_behavior": { "enum": ["mark_and_rebuild", "deny_runtime_retrieval", "block_material_change_review"] }
      }
    },
    "control_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{3}$" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "localReference": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\\\).+$" },
    "nonEmptyStrings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 4 } },
    "idArray": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "kind", "uri", "authority", "classification", "revision", "owner", "included"],
      "properties": {
        "source_id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["code", "documentation", "interface", "infrastructure", "data", "policy", "runbook", "telemetry", "other"] },
        "uri": { "$ref": "#/$defs/localReference" },
        "authority": { "enum": ["source_of_truth", "reference", "derived"] },
        "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
        "revision": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 2 },
        "included": { "type": "boolean" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "kind", "owner", "classification", "source_refs"],
      "properties": {
        "node_id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["system", "service", "repository", "component", "interface", "data_product", "policy", "workflow_step", "decision", "capability", "model_route", "evaluation", "runbook", "user_surface"] },
        "owner": { "type": "string", "minLength": 2 },
        "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
        "source_refs": { "$ref": "#/$defs/idArray" }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation_id", "source_node_id", "target_node_id", "type", "basis", "confidence", "source_refs"],
      "properties": {
        "relation_id": { "$ref": "#/$defs/id" },
        "source_node_id": { "$ref": "#/$defs/id" },
        "target_node_id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["depends_on", "implements", "reads", "writes", "governed_by", "owned_by", "evaluated_by", "operated_by", "exposes", "uses", "impacts"] },
        "basis": { "enum": ["extracted", "inferred"] },
        "confidence": { "enum": ["verified", "high", "medium", "low"] },
        "source_refs": { "$ref": "#/$defs/idArray" }
      }
    }
  }
}

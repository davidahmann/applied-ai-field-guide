{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/davidahmann/fde-guide/schemas/evaluation-output.schema.json",
  "title": "Immutable evaluator runner output evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "report_id", "report_version", "summary_digest", "suite_digest", "fixture_digest", "system_digest", "grader_digest", "runner_digest", "environment_digest", "runner_output_digest", "runner_output", "population", "resource_usage", "trials", "results", "contamination_controls", "cases"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "report_id": { "$ref": "#/$defs/id" },
    "report_version": { "$ref": "#/$defs/version" },
    "summary_digest": { "$ref": "#/$defs/digest" },
    "suite_digest": { "$ref": "#/$defs/digest" },
    "fixture_digest": { "$ref": "#/$defs/digest" },
    "system_digest": { "$ref": "#/$defs/digest" },
    "grader_digest": { "$ref": "#/$defs/digest" },
    "runner_digest": { "$ref": "#/$defs/digest" },
    "environment_digest": { "$ref": "#/$defs/digest" },
    "runner_output_digest": { "$ref": "#/$defs/digest", "$comment": "SHA-256 over the domain-separated canonical runner_output object, enforced by repository validation." },
    "runner_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "wall_time_ms", "execution_environment", "cases"],
      "properties": {
        "status": { "const": "passed" },
        "wall_time_ms": { "type": "integer", "minimum": 0 },
        "execution_environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["component_id", "version", "image_digest", "isolation", "cpu_limit", "memory_limit_mb", "filesystem", "max_wall_time_ms", "network_enforced", "wall_time_enforced"],
          "properties": {
            "component_id": { "type": "string", "minLength": 2 },
            "version": { "$ref": "#/$defs/version" },
            "image_digest": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
            "isolation": { "enum": ["container", "microvm", "wasm", "host_process"] },
            "cpu_limit": { "oneOf": [{ "type": "number", "exclusiveMinimum": 0 }, { "type": "null" }] },
            "memory_limit_mb": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
            "filesystem": { "enum": ["read_only", "ephemeral", "copy_on_write", "host_workspace"] },
            "max_wall_time_ms": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
            "network_enforced": { "type": "boolean" },
            "wall_time_enforced": { "type": "boolean" }
          }
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["case_id", "status"],
            "properties": {
              "case_id": { "$ref": "#/$defs/id" },
              "status": { "const": "passed" }
            }
          }
        }
      }
    },
    "population": { "type": "object" },
    "resource_usage": { "type": "object" },
    "trials": { "type": "object" },
    "results": { "type": "array", "minItems": 1 },
    "contamination_controls": { "type": "object" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "status", "trial_count", "execution_digest"],
        "properties": {
          "case_id": { "$ref": "#/$defs/id" },
          "status": { "const": "pass" },
          "trial_count": { "type": "integer", "minimum": 1 },
          "execution_digest": { "$ref": "#/$defs/digest" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}

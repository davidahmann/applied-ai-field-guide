{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/davidahmann/fde-guide/schemas/operational-ontology.schema.json",
  "title": "Operational ontology",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "ontology_id", "version", "domain", "owners", "entities", "relationships", "actions", "policies", "invariants", "evidence_types"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.1.0" },
    "ontology_id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/version" },
    "domain": { "type": "string", "minLength": 2 },
    "owners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2 }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity_id", "layer", "stewardship", "source_of_truth", "identity_keys", "attributes", "lifecycle_states", "lifecycle_transitions"],
        "properties": {
          "entity_id": { "$ref": "#/$defs/id" },
          "layer": { "enum": ["core", "derived", "use_case"] },
          "stewardship": {
            "type": "object",
            "additionalProperties": false,
            "required": ["owner", "change_authority", "retention_policy"],
            "properties": {
              "owner": { "type": "string", "minLength": 2 },
              "change_authority": { "type": "string", "minLength": 2 },
              "retention_policy": { "type": "string", "minLength": 2 }
            }
          },
          "source_of_truth": { "type": "string", "minLength": 2 },
          "identity_keys": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          },
          "attributes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type", "required", "classification", "temporal"],
              "properties": {
                "name": { "$ref": "#/$defs/id" },
                "type": { "enum": ["boolean", "date", "datetime", "decimal", "integer", "object", "string"] },
                "required": { "type": "boolean" },
                "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
                "temporal": { "type": "boolean" }
              }
            }
          },
          "lifecycle_states": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          },
          "lifecycle_transitions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["transition_id", "from_state", "to_state", "trigger", "guard", "owner"],
              "properties": {
                "transition_id": { "$ref": "#/$defs/id" },
                "from_state": {
                  "anyOf": [
                    { "$ref": "#/$defs/id" },
                    { "const": "absent" }
                  ]
                },
                "to_state": { "$ref": "#/$defs/id" },
                "trigger": { "type": "string", "minLength": 3 },
                "guard": { "type": "string", "minLength": 3 },
                "owner": { "type": "string", "minLength": 2 }
              }
            }
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relationship_id", "from", "to", "cardinality", "source_of_truth"],
        "properties": {
          "relationship_id": { "$ref": "#/$defs/id" },
          "from": { "$ref": "#/$defs/id" },
          "to": { "$ref": "#/$defs/id" },
          "cardinality": { "enum": ["one_to_one", "one_to_many", "many_to_one", "many_to_many"] },
          "source_of_truth": { "type": "string", "minLength": 2 }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_id", "actor_types", "input_entities", "output_entities", "permitted_transitions", "decision_contract", "preconditions", "postconditions", "authorization_policy", "side_effect", "idempotency_scope", "feedback"],
        "properties": {
          "action_id": { "$ref": "#/$defs/id" },
          "actor_types": { "$ref": "#/$defs/nonEmptyIds" },
          "input_entities": { "$ref": "#/$defs/nonEmptyIds" },
          "output_entities": { "$ref": "#/$defs/nonEmptyIds" },
          "permitted_transitions": { "$ref": "#/$defs/nonEmptyIds" },
          "decision_contract": {
            "type": "object",
            "additionalProperties": false,
            "required": ["decision_id", "evidence_types", "deterministic_checks", "uncertainty_policy", "owner"],
            "properties": {
              "decision_id": { "$ref": "#/$defs/id" },
              "evidence_types": { "$ref": "#/$defs/nonEmptyIds" },
              "deterministic_checks": { "$ref": "#/$defs/nonEmptyStrings" },
              "uncertainty_policy": { "type": "string", "minLength": 5 },
              "owner": { "type": "string", "minLength": 2 }
            }
          },
          "preconditions": { "$ref": "#/$defs/nonEmptyStrings" },
          "postconditions": { "$ref": "#/$defs/nonEmptyStrings" },
          "authorization_policy": { "$ref": "#/$defs/id" },
          "side_effect": { "enum": ["none", "staged", "reversible", "irreversible"] },
          "idempotency_scope": { "type": ["string", "null"] },
          "feedback": {
            "type": "object",
            "additionalProperties": false,
            "required": ["accepted_event", "outcome_source", "reconciliation_slo_seconds", "metric_id"],
            "properties": {
              "accepted_event": { "type": "string", "minLength": 5 },
              "outcome_source": { "type": "string", "minLength": 2 },
              "reconciliation_slo_seconds": { "type": "integer", "minimum": 0 },
              "metric_id": { "$ref": "#/$defs/id" }
            }
          }
        }
      }
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["policy_id", "decision", "inputs", "enforcement_point", "fail_mode"],
        "properties": {
          "policy_id": { "$ref": "#/$defs/id" },
          "decision": { "enum": ["allow", "deny", "allow_with_obligations"] },
          "inputs": { "$ref": "#/$defs/nonEmptyIds" },
          "enforcement_point": { "type": "string", "minLength": 2 },
          "fail_mode": { "const": "closed" }
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["invariant_id", "expression", "enforcement", "severity"],
        "properties": {
          "invariant_id": { "$ref": "#/$defs/id" },
          "expression": { "type": "string", "minLength": 5 },
          "enforcement": { "type": "string", "minLength": 2 },
          "severity": { "enum": ["low", "medium", "high", "critical"] }
        }
      }
    },
    "evidence_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "source", "owner", "source_of_truth", "revision_contract", "schema_contract", "freshness_slo_seconds", "classification"],
        "properties": {
          "evidence_id": { "$ref": "#/$defs/id" },
          "source": { "type": "string", "minLength": 2 },
          "owner": { "type": "string", "minLength": 2 },
          "source_of_truth": { "type": "boolean" },
          "revision_contract": { "type": "string", "minLength": 3 },
          "schema_contract": { "type": "string", "minLength": 3 },
          "freshness_slo_seconds": { "type": "integer", "minimum": 0 },
          "classification": { "enum": ["public", "internal", "confidential", "restricted"] }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "nonEmptyIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    }
  }
}

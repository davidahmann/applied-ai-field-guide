{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/davidahmann/fde-guide/schemas/behavior-bundle.schema.json",
  "title": "Immutable agent behavior component bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "bundle_id", "version", "status", "components", "tool_members", "control_ids"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "bundle_id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/version" },
    "status": { "enum": ["candidate", "verified", "retired"] },
    "components": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/component" },
      "allOf": [
        { "contains": { "$ref": "#/$defs/modelRoute" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/promptBundle" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/harness" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/contextPolicy" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/toolBundle" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/guardrailPolicy" }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "tool_members": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/toolMember" }
    },
    "control_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{3}$" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "localReference": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\\\).+$" },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "role", "version", "configuration"],
      "properties": {
        "component_id": { "$ref": "#/$defs/id" },
        "role": { "enum": ["model_route", "prompt_bundle", "harness", "context_policy", "tool_bundle", "guardrail_policy"] },
        "version": { "$ref": "#/$defs/version" },
        "configuration": {
          "type": "object",
          "minProperties": 1
        }
      }
    },
    "toolMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_id", "contract_uri", "contract_version", "contract_schema_version", "contract_digest", "capability_manifest_uri", "capability_id", "capability_version", "capability_manifest_digest", "authority_digest"],
      "properties": {
        "tool_id": { "$ref": "#/$defs/id" },
        "contract_uri": { "$ref": "#/$defs/localReference" },
        "contract_version": { "$ref": "#/$defs/version" },
        "contract_schema_version": { "$ref": "#/$defs/version" },
        "contract_digest": { "$ref": "#/$defs/digest" },
        "capability_manifest_uri": { "$ref": "#/$defs/localReference" },
        "capability_id": { "$ref": "#/$defs/id" },
        "capability_version": { "$ref": "#/$defs/version" },
        "capability_manifest_digest": { "$ref": "#/$defs/digest" },
        "authority_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "modelRoute": { "type": "object", "properties": { "role": { "const": "model_route" } }, "required": ["role"] },
    "promptBundle": { "type": "object", "properties": { "role": { "const": "prompt_bundle" } }, "required": ["role"] },
    "harness": { "type": "object", "properties": { "role": { "const": "harness" } }, "required": ["role"] },
    "contextPolicy": { "type": "object", "properties": { "role": { "const": "context_policy" } }, "required": ["role"] },
    "toolBundle": { "type": "object", "properties": { "role": { "const": "tool_bundle" } }, "required": ["role"] },
    "guardrailPolicy": { "type": "object", "properties": { "role": { "const": "guardrail_policy" } }, "required": ["role"] }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/davidahmann/fde-guide/schemas/agent-system.schema.json",
  "title": "Production agent-system design record",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "system_id", "version", "charter_uri", "owners", "outcome", "autonomy", "actor_identity", "behavior", "workflow", "context", "tools", "controls", "verification", "operations", "economics"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.2.0" },
    "system_id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/version" },
    "charter_uri": { "type": "string", "minLength": 3 },
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["technical", "operational", "risk"],
      "properties": {
        "technical": { "type": "string", "minLength": 2 },
        "operational": { "type": "string", "minLength": 2 },
        "risk": { "type": "string", "minLength": 2 }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted_event", "primary_metric", "baseline", "target", "guardrails"],
      "properties": {
        "accepted_event": { "type": "string", "minLength": 5 },
        "primary_metric": { "type": "string", "minLength": 3 },
        "baseline": { "type": "number" },
        "target": { "type": "number" },
        "guardrails": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "autonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "segments", "promotion_gate", "rollback_gate"],
      "properties": {
        "level": { "enum": ["observe", "recommend", "execute_reversible", "execute_bounded", "coordinate"] },
        "segments": { "$ref": "#/$defs/nonEmptyStrings" },
        "promotion_gate": { "type": "string", "minLength": 5 },
        "rollback_gate": { "type": "string", "minLength": 5 }
      }
    },
    "actor_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "agent_principal", "caller_binding", "credential_ttl_seconds", "authority_scope", "audit_attribution"],
      "properties": {
        "mode": { "enum": ["interactive_delegated", "unattended_workload", "mixed"] },
        "agent_principal": { "type": "string", "minLength": 3 },
        "caller_binding": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/callerBinding" }
          ]
        },
        "credential_ttl_seconds": { "type": "integer", "minimum": 1 },
        "authority_scope": { "$ref": "#/$defs/nonEmptyStrings" },
        "audit_attribution": { "enum": ["agent_only", "user_and_agent"] }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "enum": ["interactive_delegated", "mixed"] } }, "required": ["mode"] },
          "then": {
            "properties": {
              "caller_binding": { "$ref": "#/$defs/callerBinding" },
              "audit_attribution": { "const": "user_and_agent" }
            }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "unattended_workload" } }, "required": ["mode"] },
          "then": {
            "properties": {
              "caller_binding": { "type": "null" },
              "audit_attribution": { "const": "agent_only" }
            }
          }
        }
      ]
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_route", "prompt_bundle", "harness", "context_policy", "tool_bundle", "guardrail_policy"],
      "properties": {
        "model_route": { "$ref": "#/$defs/versionedComponent" },
        "prompt_bundle": { "$ref": "#/$defs/versionedComponent" },
        "harness": { "$ref": "#/$defs/versionedComponent" },
        "context_policy": { "$ref": "#/$defs/versionedComponent" },
        "tool_bundle": { "$ref": "#/$defs/versionedComponent" },
        "guardrail_policy": { "$ref": "#/$defs/versionedComponent" }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "input_contract", "states", "terminal_states", "max_steps", "time_budget_ms"],
      "properties": {
        "trigger": { "type": "string", "minLength": 3 },
        "input_contract": { "type": "string", "minLength": 3 },
        "states": { "$ref": "#/$defs/nonEmptyIds" },
        "terminal_states": { "$ref": "#/$defs/nonEmptyIds" },
        "max_steps": { "type": "integer", "minimum": 1 },
        "time_budget_ms": { "type": "integer", "minimum": 1 }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ontology_uri", "sources", "untrusted_content_policy"],
      "properties": {
        "ontology_uri": { "type": "string", "minLength": 3 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "owner", "source_of_truth", "revision", "schema_contract", "freshness_slo_seconds", "classification", "trust"],
            "properties": {
              "source_id": { "$ref": "#/$defs/id" },
              "owner": { "type": "string", "minLength": 2 },
              "source_of_truth": { "type": "boolean" },
              "revision": { "type": "string", "minLength": 1 },
              "schema_contract": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "version", "digest"],
                "properties": {
                  "id": { "type": "string", "minLength": 3 },
                  "version": { "type": "string", "minLength": 1 },
                  "digest": { "$ref": "#/$defs/digest" }
                }
              },
              "freshness_slo_seconds": { "type": "integer", "minimum": 0 },
              "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
              "trust": { "enum": ["trusted_control", "trusted_data", "untrusted_data"] }
            }
          }
        },
        "untrusted_content_policy": { "type": "string", "minLength": 5 }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool_id", "contract_uri", "capability"],
        "properties": {
          "tool_id": { "$ref": "#/$defs/id" },
          "contract_uri": { "type": "string", "minLength": 3 },
          "capability": { "$ref": "#/$defs/capabilityBinding" }
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_ids", "propagate_caller_authorization", "secrets", "egress", "writes", "sandbox"],
      "properties": {
        "control_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{3}$" }
        },
        "propagate_caller_authorization": { "type": "boolean" },
        "secrets": { "enum": ["gateway_held", "none"] },
        "egress": { "enum": ["deny_all", "allowlist"] },
        "writes": { "enum": ["none", "staged", "approval_gated", "reversible"] },
        "sandbox": { "type": "string", "minLength": 3 }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["postconditions", "evaluation_suite_uri", "escalation_conditions"],
      "properties": {
        "postconditions": { "$ref": "#/$defs/nonEmptyStrings" },
        "evaluation_suite_uri": { "type": "string", "minLength": 3 },
        "escalation_conditions": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace_contract", "slos", "alerts", "runbook_uri", "rollback"],
      "properties": {
        "trace_contract": { "type": "string", "minLength": 3 },
        "slos": { "$ref": "#/$defs/nonEmptyStrings" },
        "alerts": { "$ref": "#/$defs/nonEmptyStrings" },
        "runbook_uri": { "type": "string", "minLength": 3 },
        "rollback": { "type": "string", "minLength": 5 }
      }
    },
    "economics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cost_metric", "max_cost_per_run_usd", "max_cost_per_accepted_outcome_usd"],
      "properties": {
        "cost_metric": { "const": "cost_per_accepted_outcome" },
        "max_cost_per_run_usd": { "type": "number", "exclusiveMinimum": 0 },
        "max_cost_per_accepted_outcome_usd": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "actor_identity": {
            "type": "object",
            "properties": { "mode": { "enum": ["interactive_delegated", "mixed"] } },
            "required": ["mode"]
          }
        },
        "required": ["actor_identity"]
      },
      "then": {
        "properties": {
          "controls": {
            "type": "object",
            "properties": { "propagate_caller_authorization": { "const": true } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "autonomy": {
            "type": "object",
            "properties": { "level": { "enum": ["execute_reversible", "execute_bounded", "coordinate"] } },
            "required": ["level"]
          }
        },
        "required": ["autonomy"]
      },
      "then": {
        "properties": {
          "controls": {
            "type": "object",
            "properties": { "propagate_caller_authorization": { "const": true } }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "callerBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_type", "subject_claim", "tenant_claim", "session_id_claim", "max_session_age_seconds"],
      "properties": {
        "binding_type": { "enum": ["user_session", "delegation_token"] },
        "subject_claim": { "type": "string", "minLength": 1 },
        "tenant_claim": { "type": "string", "minLength": 1 },
        "session_id_claim": { "type": "string", "minLength": 1 },
        "max_session_age_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "capabilityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_uri", "capability_id", "version", "manifest_digest", "authority_digest"],
      "properties": {
        "manifest_uri": { "type": "string", "minLength": 3 },
        "capability_id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "manifest_digest": { "$ref": "#/$defs/digest" },
        "authority_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "versionedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "uri", "version", "schema_version", "digest"],
      "properties": {
        "component_id": { "$ref": "#/$defs/id" },
        "uri": { "type": "string", "minLength": 3 },
        "version": { "$ref": "#/$defs/version" },
        "schema_version": { "$ref": "#/$defs/version" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "nonEmptyIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    }
  }
}

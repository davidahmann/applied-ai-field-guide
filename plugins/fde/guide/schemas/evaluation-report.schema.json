{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/davidahmann/fde-guide/schemas/evaluation-report.schema.json",
  "title": "Production agent evaluation report",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "report_id", "version", "owner", "generated_at", "claim", "objective", "population", "system", "suite", "evaluator", "resource_budgets", "resource_usage", "trials", "results", "contamination_controls", "limitations", "decision", "control_ids"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "report_id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/version" },
    "owner": { "type": "string", "minLength": 2 },
    "generated_at": { "type": "string", "format": "date-time" },
    "claim": { "type": "string", "minLength": 20 },
    "objective": { "enum": ["capability", "regression", "safety", "operational"] },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible_population", "segments", "eligible_cases", "evaluated_cases", "excluded_cases", "case_coverage"],
      "properties": {
        "eligible_population": { "$ref": "#/$defs/eligiblePopulation" },
        "segments": { "$ref": "#/$defs/nonEmptyStrings" },
        "eligible_cases": { "type": "integer", "minimum": 1 },
        "evaluated_cases": { "type": "integer", "minimum": 0 },
        "excluded_cases": { "type": "integer", "minimum": 0 },
        "case_coverage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slice", "eligible_cases", "evaluated_cases", "rationale"],
            "properties": {
              "slice": { "type": "string", "minLength": 2 },
              "eligible_cases": { "type": "integer", "minimum": 1 },
              "evaluated_cases": { "type": "integer", "minimum": 0 },
              "rationale": { "type": "string", "minLength": 10 }
            }
          }
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_system_uri", "system_version", "system_digest", "component_manifest", "environment"],
      "properties": {
        "agent_system_uri": { "$ref": "#/$defs/localReference" },
        "system_version": { "$ref": "#/$defs/version" },
        "system_digest": { "$ref": "#/$defs/digest", "$comment": "SHA-256 of the exact agent-system file bytes." },
        "component_manifest": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "component_id", "version", "digest"],
            "properties": {
              "role": { "enum": ["model_route", "prompt_bundle", "tool_bundle", "context_policy", "guardrail_bundle"] },
              "component_id": { "type": "string", "minLength": 2 },
              "version": { "type": "string", "minLength": 1 },
              "digest": { "$ref": "#/$defs/digest" }
            }
          },
          "allOf": [
            { "contains": { "type": "object", "properties": { "role": { "const": "model_route" } }, "required": ["role"] } },
            { "contains": { "type": "object", "properties": { "role": { "const": "prompt_bundle" } }, "required": ["role"] } },
            { "contains": { "type": "object", "properties": { "role": { "const": "tool_bundle" } }, "required": ["role"] } },
            { "contains": { "type": "object", "properties": { "role": { "const": "context_policy" } }, "required": ["role"] } },
            { "contains": { "type": "object", "properties": { "role": { "const": "guardrail_bundle" } }, "required": ["role"] } }
          ]
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runtime", "harness", "sandbox", "world", "policy", "dependencies", "environment_digest", "network_mode"],
          "properties": {
            "runtime": { "$ref": "#/$defs/immutableArtifactComponent" },
            "harness": { "$ref": "#/$defs/immutableComponent" },
            "sandbox": { "$ref": "#/$defs/sandboxProfile" },
            "world": { "$ref": "#/$defs/immutableArtifactComponent" },
            "policy": { "$ref": "#/$defs/immutableArtifactComponent" },
            "dependencies": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/immutableArtifactComponent" }
            },
            "environment_digest": { "$ref": "#/$defs/digest", "$comment": "SHA-256 over the domain-separated canonical environment payload enforced by scripts/contract-invariants.mjs." },
            "network_mode": { "enum": ["denied", "replayed", "controlled", "unenforced", "not_executed"] }
          }
        }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "version", "schema_version", "digest", "fixture_uri", "fixture_revision", "fixture_schema_version", "fixture_digest", "holdout_isolated", "agent_can_modify"],
      "properties": {
        "uri": { "$ref": "#/$defs/localReference" },
        "version": { "$ref": "#/$defs/nullableVersion" },
        "schema_version": { "$ref": "#/$defs/nullableVersion" },
        "digest": { "$ref": "#/$defs/digest", "$comment": "SHA-256 of the exact suite file bytes or the deterministic directory digest enforced by the repository validator." },
        "fixture_uri": { "$ref": "#/$defs/localReference" },
        "fixture_revision": { "$ref": "#/$defs/nullableVersion" },
        "fixture_schema_version": { "$ref": "#/$defs/nullableVersion" },
        "fixture_digest": { "$ref": "#/$defs/digest" },
        "holdout_isolated": { "type": "boolean" },
        "agent_can_modify": { "const": false }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grader", "runner", "output", "minimum_confidence"],
      "properties": {
        "grader": { "$ref": "#/$defs/immutableArtifactComponent" },
        "runner": { "$ref": "#/$defs/immutableArtifactComponent" },
        "output": { "$ref": "#/$defs/outputComponent", "$comment": "Accepted reports bind exact raw evaluator output bytes; non-accepted templates use SHA-256 over UTF-8 domain production-agent-engineering/canonical-json/v1/evaluation-summary followed by NUL and canonical JSON as implemented by scripts/contract-invariants.mjs." },
        "minimum_confidence": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "resource_budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_turns", "max_tool_calls", "max_total_tokens", "max_wall_time_ms", "max_cost_usd", "max_parallel_workers"],
      "properties": {
        "max_turns": { "type": "integer", "minimum": 1 },
        "max_tool_calls": { "type": "integer", "minimum": 0 },
        "max_total_tokens": { "type": "integer", "minimum": 1 },
        "max_wall_time_ms": { "type": "integer", "minimum": 1 },
        "max_cost_usd": { "type": "number", "minimum": 0 },
        "max_parallel_workers": { "type": "integer", "minimum": 1 }
      }
    },
    "resource_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turns", "tool_calls", "total_tokens", "wall_time_ms", "cost_usd", "peak_parallel_workers"],
      "properties": {
        "turns": { "type": "integer", "minimum": 0 },
        "tool_calls": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "wall_time_ms": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 },
        "peak_parallel_workers": { "type": "integer", "minimum": 0 }
      }
    },
    "trials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "independent", "state_reset_between_trials", "aggregation", "k", "quantile"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "independent": { "type": "boolean" },
        "state_reset_between_trials": { "type": "boolean" },
        "aggregation": { "enum": ["single_pass", "mean", "quantile", "pass_at_k", "pass_power_k"] },
        "k": { "type": ["integer", "null"], "minimum": 1 },
        "quantile": { "type": ["number", "null"], "exclusiveMinimum": 0, "exclusiveMaximum": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "aggregation": { "enum": ["pass_at_k", "pass_power_k"] } }, "required": ["aggregation"] },
          "then": { "properties": { "k": { "type": "integer", "minimum": 1 } } },
          "else": { "properties": { "k": { "type": "null" } } }
        },
        {
          "if": { "properties": { "aggregation": { "const": "quantile" } }, "required": ["aggregation"] },
          "then": { "properties": { "quantile": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 } } },
          "else": { "properties": { "quantile": { "type": "null" } } }
        }
      ]
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "slice", "value", "unit", "threshold", "pass", "uncertainty"],
        "properties": {
          "metric": { "type": "string", "minLength": 2 },
          "slice": { "type": "string", "minLength": 2 },
          "value": { "type": "number" },
          "unit": { "type": "string", "minLength": 1 },
          "threshold": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operator", "value"],
            "properties": {
              "operator": { "enum": ["eq", "lte", "gte"] },
              "value": { "type": "number" }
            }
          },
          "pass": { "type": "boolean" },
          "uncertainty": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["method", "lower", "upper", "confidence"],
                "properties": {
                  "method": { "type": "string", "minLength": 2 },
                  "lower": { "type": "number" },
                  "upper": { "type": "number" },
                  "confidence": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
                }
              }
            ]
          }
        }
      }
    },
    "contamination_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answer_key_access", "cross_trial_state", "external_network", "known_exposures", "reference_solution_reviewed"],
      "properties": {
        "answer_key_access": { "const": false },
        "cross_trial_state": { "const": false },
        "external_network": { "enum": ["denied", "replayed", "controlled", "unenforced", "not_executed"] },
        "known_exposures": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
        "reference_solution_reviewed": { "type": "boolean" }
      }
    },
    "limitations": { "$ref": "#/$defs/nonEmptyStrings" },
    "decision": {
      "type": "object",
      "$comment": "Repository validation proves decision structure, digest binding, timing, and principal separation only. A production gate MUST authenticate decided_by and authority_role through an external trusted identity/policy or signature verifier and fail closed when that verifier is unavailable.",
      "additionalProperties": false,
      "required": ["status", "rationale", "decided_by", "authority_role", "decided_at", "independent_from_candidate"],
      "properties": {
        "status": { "enum": ["accept", "reject", "inconclusive"] },
        "rationale": { "type": "string", "minLength": 10 },
        "decided_by": { "type": "string", "minLength": 2 },
        "authority_role": { "type": "string", "minLength": 2 },
        "decided_at": { "type": "string", "format": "date-time" },
        "independent_from_candidate": { "const": true }
      }
    },
    "control_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{3}$" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "type": "object",
            "properties": { "status": { "const": "accept" } },
            "required": ["status"]
          }
        },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "evaluator": {
            "type": "object",
            "properties": {
              "output": {
                "type": "object",
                "properties": { "uri": { "$ref": "#/$defs/localReference" } },
                "required": ["uri"]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "nullableVersion": {
      "$comment": "Use null when the referenced bytes do not declare an intrinsic artifact version; the exact SHA-256 digest remains mandatory and validator-enforced.",
      "oneOf": [
        { "$ref": "#/$defs/version" },
        { "type": "null" }
      ]
    },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "localReference": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\\\).+$" },
    "immutableComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "version", "digest"],
      "properties": {
        "component_id": { "type": "string", "minLength": 2 },
        "version": { "$ref": "#/$defs/nullableVersion" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "immutableArtifactComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "uri", "version", "schema_version", "digest"],
      "properties": {
        "component_id": { "type": "string", "minLength": 2 },
        "uri": { "$ref": "#/$defs/localReference" },
        "version": { "$ref": "#/$defs/nullableVersion" },
        "schema_version": { "$ref": "#/$defs/nullableVersion" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "sandboxProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "version", "image_digest", "isolation", "cpu_limit", "memory_limit_mb", "filesystem", "max_wall_time_ms", "network_enforced", "wall_time_enforced", "digest"],
      "properties": {
        "component_id": { "type": "string", "minLength": 2 },
        "version": { "$ref": "#/$defs/version" },
        "image_digest": {
          "oneOf": [
            { "$ref": "#/$defs/digest" },
            { "type": "null" }
          ]
        },
        "isolation": { "enum": ["container", "microvm", "wasm", "host_process", "not_executed"] },
        "cpu_limit": {
          "oneOf": [
            { "type": "number", "exclusiveMinimum": 0 },
            { "type": "null" }
          ]
        },
        "memory_limit_mb": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "filesystem": { "enum": ["read_only", "ephemeral", "copy_on_write", "host_workspace", "not_applicable"] },
        "max_wall_time_ms": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "network_enforced": { "type": "boolean" },
        "wall_time_enforced": { "type": "boolean" },
        "digest": { "$ref": "#/$defs/digest", "$comment": "SHA-256 over the domain-separated canonical sandbox profile enforced by scripts/contract-invariants.mjs." }
      },
      "allOf": [
        {
          "if": { "properties": { "isolation": { "const": "host_process" } }, "required": ["isolation"] },
          "then": {
            "properties": {
              "image_digest": { "type": "null" },
              "cpu_limit": { "type": "null" },
              "memory_limit_mb": { "type": "null" },
              "filesystem": { "const": "host_workspace" },
              "max_wall_time_ms": { "type": "null" },
              "network_enforced": { "const": false },
              "wall_time_enforced": { "const": false }
            }
          },
          "else": {
            "if": { "properties": { "isolation": { "const": "not_executed" } }, "required": ["isolation"] },
            "then": {
              "properties": {
                "image_digest": { "type": "null" },
                "cpu_limit": { "type": "null" },
                "memory_limit_mb": { "type": "null" },
                "filesystem": { "const": "not_applicable" },
                "max_wall_time_ms": { "type": "null" },
                "network_enforced": { "const": false },
                "wall_time_enforced": { "const": false }
              }
            },
            "else": {
              "properties": {
                "image_digest": { "$ref": "#/$defs/digest" },
                "cpu_limit": { "type": "number", "exclusiveMinimum": 0 },
                "memory_limit_mb": { "type": "integer", "minimum": 1 },
                "max_wall_time_ms": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      ]
    },
    "outputComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "uri", "version", "schema_version", "digest"],
      "properties": {
        "component_id": { "type": "string", "minLength": 2 },
        "uri": {
          "oneOf": [
            { "$ref": "#/$defs/localReference" },
            { "type": "null" }
          ]
        },
        "version": { "$ref": "#/$defs/nullableVersion" },
        "schema_version": { "$ref": "#/$defs/nullableVersion" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "eligiblePopulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition", "denominator_event", "exclusions", "source"],
      "properties": {
        "definition": { "type": "string", "minLength": 10 },
        "denominator_event": { "type": "string", "minLength": 5 },
        "exclusions": { "type": "array", "items": { "type": "string", "minLength": 3 } },
        "source": { "type": "string", "minLength": 3 }
      }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 4 }
    }
  }
}

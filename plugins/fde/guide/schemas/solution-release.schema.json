{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/davidahmann/fde-guide/schemas/solution-release.schema.json",
  "title": "Production agent solution release",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "release_id", "version", "release_status", "release_digest", "owner", "created_at", "workflow_charter_uri", "agent_system_uri", "evaluation_report_uri", "target_segments", "autonomy_level", "artifacts", "compatibility", "rollout", "approvals", "deployment_evidence", "rollback_evidence", "retirement_evidence", "control_ids"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.2.0" },
    "release_id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/version" },
    "release_status": { "enum": ["draft", "review", "approved", "deployed", "rolled_back", "retired"] },
    "release_digest": { "$ref": "#/$defs/digest", "$comment": "SHA-256 over UTF-8 domain production-agent-engineering/canonical-json/v1/solution-release followed by NUL and canonical JSON: object keys recursively sorted by UTF-16 code-unit order, arrays preserved, ECMAScript JSON serialization. Lifecycle state, approvals, and lifecycle evidence are excluded." },
    "owner": { "type": "string", "minLength": 2 },
    "created_at": { "type": "string", "format": "date-time" },
    "workflow_charter_uri": { "$ref": "#/$defs/localReference" },
    "agent_system_uri": { "$ref": "#/$defs/localReference" },
    "evaluation_report_uri": { "$ref": "#/$defs/localReference" },
    "target_segments": { "$ref": "#/$defs/nonEmptyStrings" },
    "autonomy_level": { "enum": ["observe", "recommend", "execute_reversible", "execute_bounded", "coordinate"] },
    "artifacts": {
      "type": "array",
      "minItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "uri", "version", "schema_version", "digest", "change_summary"],
        "properties": {
          "role": { "enum": ["workflow_charter", "data_context", "domain_model", "agent_system", "behavior_bundle", "tool_contract", "capability_manifest", "security_policy", "threat_model", "evaluation", "runtime", "user_surface", "operations"] },
          "uri": { "$ref": "#/$defs/localReference" },
          "version": { "$ref": "#/$defs/nullableVersion" },
          "schema_version": { "$ref": "#/$defs/nullableVersion" },
          "digest": { "$ref": "#/$defs/digest", "$comment": "SHA-256 of the exact referenced file bytes." },
          "change_summary": { "type": "string", "minLength": 4 }
        }
      },
      "allOf": [
        { "contains": { "$ref": "#/$defs/workflowCharterArtifact" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/dataContextArtifact" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/domainModelArtifact" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/agentSystemArtifact" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/behaviorBundleArtifact" }, "minContains": 1 },
        { "contains": { "$ref": "#/$defs/toolContractArtifact" }, "minContains": 1 },
        { "contains": { "$ref": "#/$defs/capabilityManifestArtifact" }, "minContains": 1 },
        { "contains": { "$ref": "#/$defs/securityPolicyArtifact" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/threatModelArtifact" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/evaluationArtifact" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/runtimeArtifact" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/userSurfaceArtifact" }, "minContains": 1, "maxContains": 1 },
        { "contains": { "$ref": "#/$defs/operationsArtifact" }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_id", "migration_required", "migrations", "known_incompatibilities", "verification"],
      "properties": {
        "environment_id": { "type": "string", "minLength": 2 },
        "migration_required": { "type": "boolean" },
        "migrations": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
        "known_incompatibilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
        "verification": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "traffic_percent", "soak_seconds", "success_criteria", "rollback_criteria", "kill_switch", "rollback_owner", "service_owner"],
      "properties": {
        "strategy": { "enum": ["shadow", "canary", "bounded_segment", "full_segment"] },
        "traffic_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "soak_seconds": { "type": "integer", "minimum": 1 },
        "success_criteria": { "$ref": "#/$defs/nonEmptyStrings" },
        "rollback_criteria": { "$ref": "#/$defs/nonEmptyStrings" },
        "kill_switch": { "type": "string", "minLength": 2 },
        "rollback_owner": { "type": "string", "minLength": 2 },
        "service_owner": { "type": "string", "minLength": 2 }
      },
      "allOf": [
        {
          "if": { "properties": { "strategy": { "const": "shadow" } }, "required": ["strategy"] },
          "then": { "properties": { "traffic_percent": { "const": 0 } } }
        },
        {
          "if": { "properties": { "strategy": { "const": "canary" } }, "required": ["strategy"] },
          "then": { "properties": { "traffic_percent": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 100 } } }
        },
        {
          "if": { "properties": { "strategy": { "const": "bounded_segment" } }, "required": ["strategy"] },
          "then": { "properties": { "traffic_percent": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 } } }
        },
        {
          "if": { "properties": { "strategy": { "const": "full_segment" } }, "required": ["strategy"] },
          "then": { "properties": { "traffic_percent": { "const": 100 } } }
        }
      ]
    },
    "approvals": {
      "type": "array",
      "$comment": "Repository validation proves approval structure, digest binding, timing, role coverage, and principal separation only. A production promotion service MUST authenticate every principal and authority through an external trusted identity/policy or signature verifier and fail closed when that verifier is unavailable.",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "principal", "bound_release_digest", "approved_at"],
        "properties": {
          "role": { "enum": ["technical", "operational", "risk", "service"] },
          "principal": { "type": "string", "minLength": 2 },
          "bound_release_digest": { "$ref": "#/$defs/digest" },
          "approved_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "deployment_evidence": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/deploymentEvidence" }
      ]
    },
    "rollback_evidence": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/rollbackEvidence" }
      ]
    },
    "retirement_evidence": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/retirementEvidence" }
      ]
    },
    "control_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{3}$" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "release_status": { "enum": ["approved", "deployed", "rolled_back", "retired"] } }, "required": ["release_status"] },
      "then": {
        "properties": {
          "approvals": {
            "type": "array",
            "minItems": 4,
            "allOf": [
              { "contains": { "$ref": "#/$defs/technicalApproval" }, "minContains": 1, "maxContains": 1 },
              { "contains": { "$ref": "#/$defs/operationalApproval" }, "minContains": 1, "maxContains": 1 },
              { "contains": { "$ref": "#/$defs/riskApproval" }, "minContains": 1, "maxContains": 1 },
              { "contains": { "$ref": "#/$defs/serviceApproval" }, "minContains": 1, "maxContains": 1 }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "release_status": { "enum": ["deployed", "rolled_back", "retired"] } }, "required": ["release_status"] },
      "then": { "properties": { "deployment_evidence": { "$ref": "#/$defs/deploymentEvidence" } } }
    },
    {
      "if": { "properties": { "release_status": { "const": "retired" } }, "required": ["release_status"] },
      "then": { "properties": { "retirement_evidence": { "$ref": "#/$defs/retirementEvidence" } } }
    },
    {
      "if": { "properties": { "release_status": { "const": "rolled_back" } }, "required": ["release_status"] },
      "then": { "properties": { "rollback_evidence": { "$ref": "#/$defs/rollbackEvidence" } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "nullableVersion": {
      "$comment": "Use null when the referenced bytes do not declare an intrinsic artifact version; the exact SHA-256 digest remains mandatory and validator-enforced.",
      "oneOf": [
        { "$ref": "#/$defs/version" },
        { "type": "null" }
      ]
    },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "localReference": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z][A-Za-z0-9+.-]*:)(?!/)(?!.*\\\\).+$" },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 4 }
    },
    "workflowCharterArtifact": { "type": "object", "properties": { "role": { "const": "workflow_charter" } }, "required": ["role"] },
    "dataContextArtifact": { "type": "object", "properties": { "role": { "const": "data_context" } }, "required": ["role"] },
    "domainModelArtifact": { "type": "object", "properties": { "role": { "const": "domain_model" } }, "required": ["role"] },
    "agentSystemArtifact": { "type": "object", "properties": { "role": { "const": "agent_system" } }, "required": ["role"] },
    "behaviorBundleArtifact": { "type": "object", "properties": { "role": { "const": "behavior_bundle" } }, "required": ["role"] },
    "toolContractArtifact": { "type": "object", "properties": { "role": { "const": "tool_contract" } }, "required": ["role"] },
    "capabilityManifestArtifact": { "type": "object", "properties": { "role": { "const": "capability_manifest" } }, "required": ["role"] },
    "securityPolicyArtifact": { "type": "object", "properties": { "role": { "const": "security_policy" } }, "required": ["role"] },
    "threatModelArtifact": { "type": "object", "properties": { "role": { "const": "threat_model" } }, "required": ["role"] },
    "evaluationArtifact": { "type": "object", "properties": { "role": { "const": "evaluation" } }, "required": ["role"] },
    "runtimeArtifact": { "type": "object", "properties": { "role": { "const": "runtime" } }, "required": ["role"] },
    "userSurfaceArtifact": { "type": "object", "properties": { "role": { "const": "user_surface" } }, "required": ["role"] },
    "operationsArtifact": { "type": "object", "properties": { "role": { "const": "operations" } }, "required": ["role"] },
    "technicalApproval": { "type": "object", "properties": { "role": { "const": "technical" } }, "required": ["role"] },
    "operationalApproval": { "type": "object", "properties": { "role": { "const": "operational" } }, "required": ["role"] },
    "riskApproval": { "type": "object", "properties": { "role": { "const": "risk" } }, "required": ["role"] },
    "serviceApproval": { "type": "object", "properties": { "role": { "const": "service" } }, "required": ["role"] },
    "deploymentEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deployed_at", "environment_id", "release_digest", "rollout_strategy", "observed_traffic_percent", "verification_uri", "verification_digest", "source_of_truth_readback"],
      "properties": {
        "deployed_at": { "type": "string", "format": "date-time" },
        "environment_id": { "type": "string", "minLength": 2 },
        "release_digest": { "$ref": "#/$defs/digest" },
        "rollout_strategy": { "enum": ["shadow", "canary", "bounded_segment", "full_segment"] },
        "observed_traffic_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "verification_uri": { "$ref": "#/$defs/localReference" },
        "verification_digest": { "$ref": "#/$defs/digest" },
        "source_of_truth_readback": { "const": true }
      }
    },
    "rollbackEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rolled_back_at", "reason", "release_digest", "kill_switch_activated", "compensation_status", "source_of_truth_readback", "evidence_uri", "evidence_digest"],
      "properties": {
        "rolled_back_at": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "minLength": 10 },
        "release_digest": { "$ref": "#/$defs/digest" },
        "kill_switch_activated": { "const": true },
        "compensation_status": { "enum": ["not_required", "completed"] },
        "source_of_truth_readback": { "const": true },
        "evidence_uri": { "$ref": "#/$defs/localReference" },
        "evidence_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "retirementEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retired_at", "reason", "release_digest", "identity_revoked", "capabilities_disabled", "schedules_disabled", "audit_retention_confirmed", "state_disposition", "evidence_uri", "evidence_digest"],
      "properties": {
        "retired_at": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "minLength": 10 },
        "release_digest": { "$ref": "#/$defs/digest" },
        "identity_revoked": { "const": true },
        "capabilities_disabled": { "const": true },
        "schedules_disabled": { "const": true },
        "audit_retention_confirmed": { "const": true },
        "state_disposition": { "type": "string", "minLength": 10 },
        "evidence_uri": { "$ref": "#/$defs/localReference" },
        "evidence_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}

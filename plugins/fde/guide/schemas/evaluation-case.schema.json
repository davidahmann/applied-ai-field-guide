{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/davidahmann/fde-guide/schemas/evaluation-case.schema.json",
  "title": "Production AI evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "case_id", "system_id", "title", "owner", "last_reviewed", "risk", "slice", "fixture", "input", "expected", "graders", "thresholds", "evaluator_boundary", "reference_authority", "control_ids"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.1.0" },
    "case_id": { "$ref": "#/$defs/id" },
    "system_id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 5 },
    "owner": { "type": "string", "minLength": 2 },
    "last_reviewed": { "type": "string", "format": "date" },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "prohibited_effect"],
      "properties": {
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "prohibited_effect": { "type": "boolean" }
      }
    },
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_path", "stakes", "evidence_quality", "authority", "system_condition"],
      "properties": {
        "workflow_path": { "type": "string", "minLength": 2 },
        "stakes": { "type": "string", "minLength": 2 },
        "evidence_quality": { "type": "string", "minLength": 2 },
        "authority": { "type": "string", "minLength": 2 },
        "system_condition": { "type": "string", "minLength": 2 }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["world_id", "revision", "immutable", "reset_strategy"],
      "properties": {
        "world_id": { "$ref": "#/$defs/id" },
        "revision": { "type": "string", "minLength": 1 },
        "immutable": { "type": "boolean" },
        "reset_strategy": { "type": "string", "minLength": 3 }
      }
    },
    "input": { "type": "object" },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal_state", "required_actions", "forbidden_actions", "postconditions", "forbidden_effects"],
      "properties": {
        "terminal_state": { "$ref": "#/$defs/id" },
        "required_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "forbidden_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "postconditions": { "$ref": "#/$defs/nonEmptyStrings" },
        "forbidden_effects": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "graders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["grader_id", "type", "assertion", "weight"],
        "properties": {
          "grader_id": { "$ref": "#/$defs/id" },
          "type": { "enum": ["deterministic", "rule", "semantic", "human"] },
          "assertion": { "type": "string", "minLength": 5 },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_score", "prohibited_effects_allowed"],
      "properties": {
        "minimum_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "prohibited_effects_allowed": { "const": 0 }
      }
    },
    "evaluator_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_can_modify_fixture", "agent_can_modify_graders", "agent_can_emit_pass_signal"],
      "properties": {
        "agent_can_modify_fixture": { "const": false },
        "agent_can_modify_graders": { "const": false },
        "agent_can_emit_pass_signal": { "const": false }
      }
    },
    "reference_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "source_id", "source_revision", "source_owner", "data_classification", "label_author", "approved_by", "approved_at", "adjudication_method", "disagreement_process", "review_due"],
      "properties": {
        "basis": { "enum": ["source_of_truth", "deterministic_policy", "expert_judgment", "observed_outcome", "synthetic_invariant"] },
        "source_id": { "$ref": "#/$defs/id" },
        "source_revision": { "type": "string", "minLength": 1, "maxLength": 128 },
        "source_owner": { "type": "string", "minLength": 2, "maxLength": 128 },
        "data_classification": { "enum": ["public", "internal", "confidential", "restricted"] },
        "label_author": { "type": "string", "minLength": 2, "maxLength": 128 },
        "approved_by": { "type": "string", "minLength": 2, "maxLength": 128 },
        "approved_at": { "type": "string", "format": "date-time" },
        "adjudication_method": { "enum": ["deterministic_reconciliation", "policy_owner_review", "single_expert_review", "multi_expert_consensus", "synthetic_invariant_review"] },
        "disagreement_process": { "type": "string", "minLength": 5, "maxLength": 500 },
        "review_due": { "type": "string", "format": "date" }
      }
    },
    "control_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]{3}$" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    }
  }
}
